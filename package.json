{
  "name": "rpg-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test \"scripts/**/*.test.ts\" \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "build": "tsc --rootDir . --outDir dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
