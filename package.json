{
  "name": "rpg-harness",
  "private": true,
  "author": "dreuse",
  "type": "module",
  "main": "apps/desktop/src/electron-main.ts",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test \"scripts/**/*.test.ts\" \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "test:integration": "node --test \"packages/*/src/**/*.integration.test.ts\"",
    "check:prereqs": "node scripts/check-prerequisites.ts",
    "rpg": "node apps/cli/src/bin.ts",
    "build": "tsc --rootDir . --outDir dist",
    "package:desktop": "pnpm dlx @electron/packager@20.3.0 . \"RPG Harness\" --out=out --electron-version=45.2.1 --app-version=0.0.0 --no-asar --no-prune --overwrite --ignore=/node_modules/@rpg",
    "postinstall": "pnpm --filter @rpg/desktop exec install-electron"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
